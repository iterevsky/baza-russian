  "cards": [
    {
      "id": "ru.punctuation.ambiguous-introductory.card.01",
      "front": "Как различить «кажется»?",
      "back": "Проверить, является ли оно частью сказуемого или оценкой достоверности."
    },
    {
      "id": "ru.punctuation.ambiguous-introductory.card.02",
      "front": "Почему есть запятая в «Мне кажется, что…»?",
      "back": "Она разделяет главную и придаточную части."
    },
    {
      "id": "ru.punctuation.ambiguous-introductory.card.03",
      "front": "Когда «видно» не вводное?",
      "back": "Когда обозначает возможность видеть: из окна видно сад."
    },
    {
      "id": "ru.punctuation.ambiguous-introductory.card.04",
      "front": "Достаточно ли удалить слово?",
      "back": "Нет, важна его роль в предложении."
    },
    {
      "id": "ru.punctuation.ambiguous-introductory.card.05",
      "front": "Чем вводное предложение отличается от главной части сложного предложения?",
      "back": "Вводное предложение комментирует сообщение извне, а главная часть образует грамматическую структуру сложного предложения."
    }
  ],
